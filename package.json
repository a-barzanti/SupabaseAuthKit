    "test:watch": "vitest --watch",
    "test:integration": "dotenv -e .env.test -- vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc --noEmit",
    "skill:sync": "node scripts/sync-authkit.mjs",
    "skill:check": "node scripts/sync-authkit.mjs --check && node skills/supabase-authkit/scripts/verify.mjs --static",
