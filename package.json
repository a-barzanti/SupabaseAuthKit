{
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "supabase:reset": "supabase stop --no-backup && rm -rf supabase/.temp && supabase start",
    "supabase:dbreset": "supabase db reset",
    "supabase:studio": "open http://localhost:54323",
    "envupdate": "bash ./scripts/update-env.sh",
